{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/SayakMukhopadhyay/github-actions/v1/schemas/action-inputs.schema.json",
  "title": "SayakMukhopadhyay/github-actions v1 workflow inputs",
  "type": "object",
  "properties": {
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/azure-acr-token@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "client-id": {
                            "type": ["string", "number", "boolean"],
                            "description": "Client ID of the Azure identity configured for GitHub OIDC federation"
                          },
                          "tenant-id": {
                            "type": ["string", "number", "boolean"],
                            "description": "Tenant ID containing the Azure identity"
                          },
                          "subscription-id": {
                            "type": ["string", "number", "boolean"],
                            "description": "Subscription ID containing the Azure Container Registry"
                          },
                          "login-server": {
                            "type": ["string", "number", "boolean"],
                            "description": "Azure Container Registry login server without a scheme, path, or port"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["client-id", "tenant-id", "subscription-id", "login-server"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/bump-version@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Token with contents write permission for the application repository"
                          },
                          "increment": {
                            "type": ["string", "number", "boolean"],
                            "description": "patch, minor, or major"
                          },
                          "working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "Working directory of the project",
                            "default": "."
                          },
                          "helm": {
                            "type": ["string", "number", "boolean"],
                            "description": "Whether to bump Helm chart metadata",
                            "default": "false"
                          },
                          "go": {
                            "type": ["string", "number", "boolean"],
                            "description": "Whether the application is a Go project",
                            "default": "false"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["token", "increment"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/chart-update-deploy@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Token with contents write permission for the target repository"
                          },
                          "environment": {
                            "type": ["string", "number", "boolean"],
                            "description": "Environment whose wrapper chart is being promoted"
                          },
                          "chart-name": {
                            "type": ["string", "number", "boolean"],
                            "description": "Name of the chart being deployed"
                          },
                          "chart-version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional version of the chart dependency to deploy; image-tag is required when omitted",
                            "default": ""
                          },
                          "image-tag": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional image tag to set under the selected dependency values root; chart-version is required when omitted",
                            "default": ""
                          },
                          "dependency": {
                            "type": ["string", "number", "boolean"],
                            "description": "Name or alias of the dependency to update; defaults to chart-name",
                            "default": ""
                          },
                          "target-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "GitHub owner/repository containing the wrapper chart",
                            "default": "SayakMukhopadhyay/k8s-landscape-charts"
                          },
                          "target-ref": {
                            "type": ["string", "number", "boolean"],
                            "description": "Branch to update in the target repository",
                            "default": "main"
                          },
                          "wrapper-chart-path": {
                            "type": ["string", "number", "boolean"],
                            "description": "Wrapper chart path; defaults to chart-name/envs/environment",
                            "default": ""
                          },
                          "registry": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional OCI registry host; credentials are required when provided",
                            "default": ""
                          },
                          "username": {
                            "type": ["string", "number", "boolean"],
                            "description": "OCI registry username; required with password when registry is provided and forbidden otherwise",
                            "default": ""
                          },
                          "password": {
                            "type": ["string", "number", "boolean"],
                            "description": "OCI registry password or token; required with username when registry is provided and forbidden otherwise",
                            "default": ""
                          }
                        },
                        "additionalProperties": false,
                        "required": ["token", "environment", "chart-name"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/check-version@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "Working directory of the project",
                            "default": "."
                          },
                          "helm": {
                            "type": ["string", "number", "boolean"],
                            "description": "Whether the project uses Helm",
                            "default": "false"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/checkout-dependencies@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "Common project directory used when an ecosystem-specific directory is empty",
                            "default": "."
                          },
                          "go-version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Go version to configure",
                            "default": ""
                          },
                          "go-working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "Go module directory; defaults to working-directory when empty",
                            "default": ""
                          },
                          "node-version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Node.js version to configure; mutually exclusive with node-version-file",
                            "default": ""
                          },
                          "node-version-file": {
                            "type": ["string", "number", "boolean"],
                            "description": "Node.js version file relative to the checkout; mutually exclusive with node-version",
                            "default": ""
                          },
                          "node-working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "npm project directory; defaults to working-directory when empty",
                            "default": ""
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/container-build-push@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Container image tag to build"
                          },
                          "registry": {
                            "type": ["string", "number", "boolean"],
                            "description": "OCI registry host",
                            "default": "ghcr.io"
                          },
                          "image-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "Image repository below the registry; defaults to github.repository",
                            "default": ""
                          },
                          "component": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional component appended to the image repository",
                            "default": ""
                          },
                          "push": {
                            "type": ["string", "number", "boolean"],
                            "description": "Whether to publish the built image to the registry",
                            "default": "true"
                          },
                          "username": {
                            "type": ["string", "number", "boolean"],
                            "description": "Registry username; required with password when push is true, otherwise optional only as a complete pair",
                            "default": ""
                          },
                          "password": {
                            "type": ["string", "number", "boolean"],
                            "description": "Registry password or token; required with username when push is true, otherwise optional only as a complete pair",
                            "default": ""
                          },
                          "working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "Docker build context relative to the checkout",
                            "default": "."
                          },
                          "auth-token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional BuildKit secret named auth-token",
                            "default": ""
                          },
                          "build-contexts": {
                            "type": ["string", "number", "boolean"],
                            "description": "Additional named Docker build contexts",
                            "default": ""
                          },
                          "build-args": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional build arguments forwarded unchanged to Docker Buildx",
                            "default": ""
                          },
                          "cache-from": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional newline-delimited external cache sources forwarded unchanged to Docker Buildx",
                            "default": ""
                          },
                          "cache-to": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional newline-delimited external cache destinations forwarded unchanged to Docker Buildx",
                            "default": ""
                          }
                        },
                        "additionalProperties": false,
                        "required": ["version"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "uses": { "const": "SayakMukhopadhyay/github-actions/container-image-inspect@v1" }
                    },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Container image tag to inspect"
                          },
                          "registry": {
                            "type": ["string", "number", "boolean"],
                            "description": "OCI registry host",
                            "default": "ghcr.io"
                          },
                          "image-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "Image repository below the registry; defaults to github.repository",
                            "default": ""
                          },
                          "component": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional component appended to the image repository",
                            "default": ""
                          },
                          "username": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional registry username; must be provided together with password",
                            "default": ""
                          },
                          "password": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional registry password or token; must be provided together with username",
                            "default": ""
                          }
                        },
                        "additionalProperties": false,
                        "required": ["version"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/container-promote@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "source-digest": {
                            "type": ["string", "number", "boolean"],
                            "description": "Published sha256 image digest to promote"
                          },
                          "tag": {
                            "type": ["string", "number", "boolean"],
                            "description": "Target container tag to create"
                          },
                          "registry": {
                            "type": ["string", "number", "boolean"],
                            "description": "OCI registry host",
                            "default": "ghcr.io"
                          },
                          "image-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "Image repository below the registry; defaults to github.repository",
                            "default": ""
                          },
                          "component": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional component appended to the image repository",
                            "default": ""
                          },
                          "username": {
                            "type": ["string", "number", "boolean"],
                            "description": "Registry username; required together with password"
                          },
                          "password": {
                            "type": ["string", "number", "boolean"],
                            "description": "Registry password or token; required together with username"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["source-digest", "tag", "username", "password"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/create-release@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": ["string", "number", "boolean"],
                            "description": "GitHub token for the current repository"
                          },
                          "tag-name": {
                            "type": ["string", "number", "boolean"],
                            "description": "Already-created and already-pushed immutable tag"
                          },
                          "release-name": {
                            "type": ["string", "number", "boolean"],
                            "description": "Displayed GitHub Release name"
                          },
                          "openai-wif-audience": {
                            "type": ["string", "number", "boolean"],
                            "description": "Audience configured on the OpenAI workload identity provider"
                          },
                          "openai-identity-provider-id": {
                            "type": ["string", "number", "boolean"],
                            "description": "OpenAI workload identity provider identifier"
                          },
                          "openai-service-account-id": {
                            "type": ["string", "number", "boolean"],
                            "description": "OpenAI service account identifier used by workload identity federation"
                          },
                          "pathspecs": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional newline-delimited native Git pathspecs used to scope commits and file evidence",
                            "default": ""
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "token",
                          "tag-name",
                          "release-name",
                          "openai-wif-audience",
                          "openai-identity-provider-id",
                          "openai-service-account-id"
                        ]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/deploy-pages-artifact@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "github-token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Token that can read the source artifact"
                          },
                          "source-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "Source repository in owner/repository form"
                          },
                          "source-run-id": {
                            "type": ["string", "number", "boolean"],
                            "description": "Source workflow run ID containing the artifact"
                          },
                          "artifact-name": {
                            "type": ["string", "number", "boolean"],
                            "description": "Name of the source workflow artifact containing the built static site"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["github-token", "source-repository", "source-run-id", "artifact-name"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "uses": { "const": "SayakMukhopadhyay/github-actions/dispatch-pages-deployment@v1" }
                    },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "github-token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Token with contents write permission for the target repository"
                          },
                          "target-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "Target publisher repository in owner/repository form"
                          },
                          "artifact-name": {
                            "type": ["string", "number", "boolean"],
                            "description": "Name of the source workflow artifact containing the built static site"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["github-token", "target-repository", "artifact-name"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/helm-package-push@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "development": {
                            "type": ["string", "number", "boolean"],
                            "description": "Whether to create version 0.0.0-build-<full lowercase commit SHA>",
                            "default": "false"
                          },
                          "app-version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional application version override passed to helm package",
                            "default": ""
                          },
                          "registry": {
                            "type": ["string", "number", "boolean"],
                            "description": "OCI registry host",
                            "default": "ghcr.io"
                          },
                          "repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "Chart repository below the registry; defaults to github.repository_owner/charts",
                            "default": ""
                          },
                          "push": {
                            "type": ["string", "number", "boolean"],
                            "description": "Whether to publish the packaged chart to the registry",
                            "default": "true"
                          },
                          "username": {
                            "type": ["string", "number", "boolean"],
                            "description": "Registry username; required with password when push is true, otherwise optional only as a complete pair",
                            "default": ""
                          },
                          "password": {
                            "type": ["string", "number", "boolean"],
                            "description": "Registry password or token; required with username when push is true, otherwise optional only as a complete pair",
                            "default": ""
                          },
                          "working-directory": {
                            "type": ["string", "number", "boolean"],
                            "description": "Working directory of the project",
                            "default": "."
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/is-file-changed@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "pattern": {
                            "type": ["string", "number", "boolean"],
                            "description": "JavaScript regular expression matched against changed repository paths"
                          },
                          "base-ref": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional explicit base commit object ID or Git ref; must be provided with head-ref"
                          },
                          "head-ref": {
                            "type": ["string", "number", "boolean"],
                            "description": "Optional explicit head commit object ID or Git ref; must be provided with base-ref"
                          },
                          "token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Token used to checkout and fetch the repository",
                            "default": "${{ github.token }}"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["pattern"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/release-tags@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": ["string", "number", "boolean"],
                            "description": "GitHub token with contents read permission, plus contents write permission in ensure mode"
                          },
                          "tags": {
                            "type": ["string", "number", "boolean"],
                            "description": "Newline-delimited Git tag names"
                          },
                          "mode": {
                            "type": ["string", "number", "boolean"],
                            "description": "exists to check presence, verify to check the caller commit, or ensure to create missing tags",
                            "default": "verify"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["token", "tags"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "uses": { "const": "SayakMukhopadhyay/github-actions/static-site-update-deploy@v1" }
                    },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": ["string", "number", "boolean"],
                            "description": "Token with contents write permission for the target repository"
                          },
                          "environment": {
                            "type": ["string", "number", "boolean"],
                            "description": "Environment whose wrapper chart is being promoted"
                          },
                          "chart-name": {
                            "type": ["string", "number", "boolean"],
                            "description": "Name of the static-site wrapper chart being deployed"
                          },
                          "image-version": {
                            "type": ["string", "number", "boolean"],
                            "description": "Container image tag to deploy"
                          },
                          "target-repository": {
                            "type": ["string", "number", "boolean"],
                            "description": "GitHub owner/repository containing the wrapper chart",
                            "default": "SayakMukhopadhyay/k8s-landscape-charts"
                          },
                          "target-ref": {
                            "type": ["string", "number", "boolean"],
                            "description": "Branch to update in the target repository",
                            "default": "main"
                          },
                          "wrapper-chart-path": {
                            "type": ["string", "number", "boolean"],
                            "description": "Wrapper chart path; defaults to chart-name/envs/environment",
                            "default": ""
                          }
                        },
                        "additionalProperties": false,
                        "required": ["token", "environment", "chart-name", "image-version"]
                      }
                    },
                    "required": ["with"]
                  }
                },
                {
                  "if": {
                    "properties": { "uses": { "const": "SayakMukhopadhyay/github-actions/validate-static-site@v1" } },
                    "required": ["uses"]
                  },
                  "then": {
                    "properties": {
                      "with": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": ["string", "number", "boolean"],
                            "description": "Path to the built static-site directory"
                          }
                        },
                        "additionalProperties": false,
                        "required": ["path"]
                      }
                    },
                    "required": ["with"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$comment": "Only SayakMukhopadhyay/github-actions reusable action references at @v1 are constrained by this overlay."
}
