{
  "name": "@sayakmukhopadhyay/github-actions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "npm ci && pwsh -NoProfile -File ./build.ps1 Bootstrap",
    "build": "rolldown --config rolldown.config.ts",
    "check:bundles": "tsc --project tsconfig.bundles.json",
    "format": "prettier --write \"*\" \"[!.]*/**/*\" \".github/**/*\" --ignore-unknown",
    "format:check": "prettier --check \"*\" \"[!.]*/**/*\" \".github/**/*\" --ignore-unknown",
    "generate": "node tooling/generate-action-schema.ts",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:node && npm run validate:powershell",
    "validate:generated": "npm run generate && git diff --exit-code -- schemas/action-inputs.schema.json && npm run build && git diff --exit-code -- \":(glob)**/dist/**\" && npm run check:bundles",
    "validate:node": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate:generated",
    "validate:powershell": "pwsh -NoProfile -File ./build.ps1 Validate"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "openai": "7.10.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "rolldown": "1.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
