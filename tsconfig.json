{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "check-version/**/*.ts",
    "validate-static-site/**/*.ts",
    "dispatch-pages-deployment/**/*.ts",
    "actions/**/*.ts",
    "tooling/**/*.ts",
    "tests/**/*.ts"
  ]
}
