#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$@" > "$ARGOCD_FAKE_LOG"
[[ ${ARGOCD_AUTH_TOKEN:-} == fixture-argocd-token ]] || exit 90

printf '{"status":{"sync":{"status":"%s","revision":"%s"},"health":{"status":"%s"}}}\n' \
  "${ARGOCD_FAKE_SYNC_STATUS:-Synced}" \
  "${ARGOCD_FAKE_REVISION:?}" \
  "${ARGOCD_FAKE_HEALTH_STATUS:-Healthy}"

if [[ ${ARGOCD_FAKE_EXIT:-0} != 0 ]]; then
  printf 'timed out waiting for fixture Application\n' >&2
  exit "$ARGOCD_FAKE_EXIT"
fi
